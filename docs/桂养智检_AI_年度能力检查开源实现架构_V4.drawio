        <mxCell id="ref-icope" value="&lt;b&gt;WHO ICOPE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;运动、感官、认知与心理&lt;br/&gt;强调以老人需求为中心&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8C68;fillColor=#FFFFFF;fontColor=#28553B;fontSize=14;" vertex="1" parent="evidence-layer">
