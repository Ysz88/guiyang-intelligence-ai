        <mxCell id="out-list" value="&lt;b&gt;待复核名单&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;红/橙关注｜缺项｜冲突&lt;br/&gt;一键回到原检查记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C27B27;fillColor=#FFFFFF;fontColor=#754611;fontSize=15;" vertex="1" parent="output-layer">
          <mxGeometry x="580" y="55" width="255" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="out-org" value="&lt;b&gt;养老院汇总看板&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;完成率｜等级分布｜复核队列&lt;br/&gt;主要能力缺口与服务需求&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#7664A5;fillColor=#FFFFFF;fontColor=#493B73;fontSize=15;" vertex="1" parent="output-layer">
          <mxGeometry x="855" y="55" width="255" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="out-regulatory" value="&lt;b&gt;脱敏监管摘要&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;机构计数｜完成率｜关注分布&lt;br/&gt;不上行姓名、语言背景与任务明细&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#5077A1;fillColor=#FFFFFF;fontColor=#244768;fontSize=15;" vertex="1" parent="output-layer">
          <mxGeometry x="1130" y="55" width="255" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="data-layer" value="4. 数据与样本策略" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;arcSize=6;strokeWidth=2;strokeColor=#6B6F73;fillColor=#ECEFF1;fontColor=#34383B;fontSize=15;fontStyle=1;" vertex="1" parent="1">
