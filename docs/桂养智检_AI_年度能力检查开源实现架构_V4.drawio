        <mxCell id="out-trend" value="&lt;b&gt;年度变化对比&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;与上次结果比较&lt;br/&gt;标记改善/稳定/下降&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#5077A1;fillColor=#FFFFFF;fontColor=#244768;fontSize=15;" vertex="1" parent="output-layer">
