  <diagram id="annual-check-v4" name="AI年度能力检查开源实现架构 V4">
    <mxGraphModel dx="1600" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;桂养智检 AI：养老院老人年度能力检查与分级辅助系统（开源实现）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=27;fontColor=#173A2C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="1460" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="四种输入可切换｜AI 只结构化｜人员全量确认｜确定性规则分级｜个人·机构·脱敏监管输出" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#4A5A52;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="1460" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="check-layer" value="1. 年度检查五维任务" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;arcSize=6;strokeWidth=2;strokeColor=#5077A1;fillColor=#DCE9F5;fontColor=#244768;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="1460" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="mobility" value="&lt;b&gt;手脚灵活&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;坐站｜行走｜转身&lt;br/&gt;抬臂｜手指对合/抓放&lt;br/&gt;完成情况 + 用时 + 关键点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8C68;fillColor=#FFFFFF;fontColor=#28553B;fontSize=16;" vertex="1" parent="check-layer">
          <mxGeometry x="25" y="55" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="speech" value="&lt;b&gt;口齿与沟通&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;固定短句 + 结构化问答&lt;br/&gt;ASR 原文 → 人工修正 → 确认&lt;br/&gt;语言背景不参与能力评分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#5077A1;fillColor=#FFFFFF;fontColor=#244768;fontSize=16;" vertex="1" parent="check-layer">
          <mxGeometry x="310" y="55" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="sensory" value="&lt;b&gt;视听能力&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;简短任务 + 标准问项&lt;br/&gt;校准设备时自动采集&lt;br/&gt;否则由护理人员录入&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#7664A5;fillColor=#FFFFFF;fontColor=#493B73;fontSize=16;" vertex="1" parent="check-layer">
          <mxGeometry x="595" y="55" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="psych" value="&lt;b&gt;心理与认知&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;简短授权问卷&lt;br/&gt;确定性逐题计分&lt;br/&gt;危机线索直接转人工&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C27B27;fillColor=#FFFFFF;fontColor=#754611;fontSize=16;" vertex="1" parent="check-layer">
          <mxGeometry x="880" y="55" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="adl" value="&lt;b&gt;日常生活能力&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;进食｜穿衣｜如厕&lt;br/&gt;移动｜用药｜照护协助&lt;br/&gt;老人 + 护理人员确认&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6B6F73;fillColor=#FFFFFF;fontColor=#34383B;fontSize=16;" vertex="1" parent="check-layer">
          <mxGeometry x="1165" y="55" width="260" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="input-note" value="&lt;b&gt;输入前：知情同意 + 摄像头/麦克风/网络自检，可随时切换输入&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;① AI 视频语音对话（TTS + 大字幕 + 允许打断）　② 触屏自填　③ 护理人员代录　④ 历史结果导入&lt;br/&gt;语音附加信息（自愿）：普通话 / 地方口音普通话 / 方言或民族语言 / 未知；仅用于 ASR 质控，不用于评分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#6B6F73;fillColor=#F3F5F3;fontColor=#344238;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="355" width="1260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="tool-layer" value="2. 浏览器交互与可替换 AI 适配层（无需先训练专用模型）" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;arcSize=6;strokeWidth=2;strokeColor=#7664A5;fillColor=#EEEAF7;fontColor=#493B73;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="1460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="pose" value="&lt;b&gt;实时视频与动作适配器&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;当前站点：getUserMedia 实时预览&lt;br/&gt;生产可接 MediaPipe Pose / Hands&lt;br/&gt;失败或拒绝时改用人工观察&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8C68;fillColor=#FFFFFF;fontColor=#28553B;fontSize=15;" vertex="1" parent="tool-layer">
          <mxGeometry x="55" y="55" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="asr" value="&lt;b&gt;语音播报与识别适配器&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;当前站点：Web Speech API + TTS&lt;br/&gt;生产可接 FunASR / faster-whisper&lt;br/&gt;原文保留、人工改字、置信度只质控&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#5077A1;fillColor=#FFFFFF;fontColor=#244768;fontSize=15;" vertex="1" parent="tool-layer">
          <mxGeometry x="400" y="55" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;结构化 AI 视频检查员&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;固定问题 + 大字幕 + 允许打断&lt;br/&gt;白名单追问 → 结构化字段草稿&lt;br/&gt;不能调用规则引擎，不能修改评分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#7664A5;fillColor=#FFFFFF;fontColor=#493B73;fontSize=15;" vertex="1" parent="tool-layer">
          <mxGeometry x="745" y="55" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="manual" value="&lt;b&gt;人工输入与质量兜底&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;拒绝音视频 / 噪声 / 遮挡提示&lt;br/&gt;护理人员确认或代录结果&lt;br/&gt;任何 AI 模块失败都不阻断检查&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C08A20;fillColor=#FFF5D9;fontColor=#704D09;fontSize=15;" vertex="1" parent="tool-layer">
          <mxGeometry x="1090" y="55" width="300" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="quality" value="&lt;b&gt;知情同意 + 数据质量 + 人工确认门&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;检查授权、缺项、噪声、遮挡、设备与置信度&lt;br/&gt;原文 → 人工修正 → 复述确认；未获同意或未确认不评分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#C08A20;fillColor=#FFF5D9;fontColor=#704D09;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="725" width="390" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="record" value="&lt;b&gt;结构化年度检查记录&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;五维逐项记录｜确认文本｜缺项｜质量提醒&lt;br/&gt;语言背景仅质控｜检查员｜规则版本｜历史结果&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;strokeColor=#6B6F73;fillColor=#F4F5F5;fontColor=#34383B;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="605" y="725" width="390" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;确定性分级规则引擎（非 LLM）&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;五维 0/1/2/3 档｜总体取最高关注档&lt;br/&gt;缺项拒判｜危机停算｜冲突复核｜版本可回放&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#9D4B45;fillColor=#F8DDD9;fontColor=#6B2824;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="725" width="390" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="decision" value="数据完整且没有危机/冲突？" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C08A20;fillColor=#FFF5D9;fontColor=#704D09;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="895" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="recheck" value="&lt;b&gt;补测或人工复核&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;重做任务｜改用手工录入&lt;br/&gt;危机线索交护理/专业人员&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C08A20;fillColor=#FFF5D9;fontColor=#704D09;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="110" y="905" width="360" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="confirm" value="&lt;b&gt;检查/复核人员确认&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;确认规则建议或人工处置结论&lt;br/&gt;记录人员、时间与说明，形成审计留痕&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8C68;fillColor=#E2F0E5;fontColor=#28553B;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1130" y="905" width="360" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="output-layer" value="3. 可直接使用的结果" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;arcSize=6;strokeWidth=2;strokeColor=#4E8C68;fillColor=#DCEEDF;fontColor=#28553B;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="1460" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="out-person" value="&lt;b&gt;个人年度结果&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;五维结果｜总体关注等级&lt;br/&gt;历史对比与照护提示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4E8C68;fillColor=#FFFFFF;fontColor=#28553B;fontSize=15;" vertex="1" parent="output-layer">
